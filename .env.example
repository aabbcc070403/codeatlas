# CodeAtlas 环境配置示例。复制为 .env 并按需修改。

# 数据库（本地默认连接 PGlite socket 服务，见 scripts/db-server.ts）
DATABASE_URL=postgres://codeatlas:local@127.0.0.1:5433/codeatlas

# 快照与上传文件的持久化根目录（相对项目根）
STORAGE_ROOT=.data/storage

# 会话与访问码
SESSION_SECRET=change-me-in-production
DEMO_ACCESS_CODE=codeatlas-demo
ADMIN_ACCESS_CODE=codeatlas-admin

# AI 供应商：mock（本地无密钥）或 openai（OpenAI 兼容接口）
AI_PROVIDER=mock
# AI_PROVIDER=openai 时必填
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# 本地嵌入（零 API 成本）：AI_EMBEDDING_MODEL=local:bge-small-zh-v1.5 且 EMBEDDING_DIM=512
# EMBEDDING_DIM 须与模型输出维度一致；换模型/维度后运行 pnpm reindex 重建向量索引
EMBEDDING_DIM=1536

# 单日 token 预算（估算输入+输出之和）
AI_DAILY_TOKEN_LIMIT=300000

# 追问轮预算的可选覆盖（优化策略调参用；不设置 = 规格默认 4 次模型 / 8 次工具 / 60s）
# 多模态截图理解需 AI_CHAT_MODEL 指向视觉语言模型（如 GLM-4V / GPT-4o / Qwen-VL）
# AI_ASK_MAX_MODEL_CALLS=
# AI_ASK_MAX_TOOL_CALLS=
# AI_ASK_WALL_MS=

# 会话与数据过期小时数
DATA_TTL_HOURS=24

# 应用对外 Origin（写请求校验用；留空时开发环境按请求 Host 推断）
APP_ORIGIN=
