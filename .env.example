# CodeAtlas 环境配置示例。复制为 .env 并按需修改。

# 数据库（本地默认连接 PGlite socket 服务，见 scripts/db-server.ts）
DATABASE_URL=postgres://codeatlas:local@127.0.0.1:5433/codeatlas

# 快照与上传文件的持久化根目录（相对项目根）
STORAGE_ROOT=.data/storage

# 会话与访问码
SESSION_SECRET=change-me-in-production
DEMO_ACCESS_CODE=codeatlas-demo
ADMIN_ACCESS_CODE=codeatlas-admin

# AI 供应商：mock（本地无密钥）或 openai（OpenAI 兼容接口）
AI_PROVIDER=mock
# AI_PROVIDER=openai 时必填
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# 单日 token 预算（估算输入+输出之和）
AI_DAILY_TOKEN_LIMIT=300000

# 会话与数据过期小时数
DATA_TTL_HOURS=24

# 应用对外 Origin（写请求校验用；留空时开发环境按请求 Host 推断）
APP_ORIGIN=
